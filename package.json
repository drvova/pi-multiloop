{
  "name": "pi-multiloop",
  "version": "0.3.2",
  "description": "Autoloop/autoresearch extension for Pi with multi-lane isolation",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package"
  ],
  "files": [
    "packages/multiloop/extensions",
    "packages/multiloop-skill/skills",
    "packages/multiloop-run/bin",
    "packages/multiloop-agent/extensions",
    "packages/child-agent/src",
    "docs/",
    "README.md"
  ],
  "bin": {
    "multiloop-run": "packages/multiloop-run/bin/multiloop-run.mjs"
  },
  "pi": {
    "extensions": [
      "./packages/multiloop/extensions",
      "./packages/multiloop-agent/extensions"
    ],
    "skills": [
      "./packages/multiloop-skill/skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "diagrams": "mmdc -i docs/diagrams/architecture.mmd -o assets/architecture.svg -b transparent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvova/pi-multiloop.git"
  },
  "author": "drvova",
  "license": "MIT",
  "homepage": "https://github.com/drvova/pi-multiloop#readme",
  "bugs": {
    "url": "https://github.com/drvova/pi-multiloop/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@sinclair/typebox": "^0.34.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
